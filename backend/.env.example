# Copy this file to ".env" and fill in the values.
# Never commit ".env" or the Firebase service account JSON file.

# HTTP port of the API
PORT=5000

# Absolute path to the Firebase Admin service account JSON file.
# Keep this file OUTSIDE the project folder.
# Firebase console > Project settings > Service accounts > Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\the\project\compussave-firebase-adminsdk.json

# Firebase Web API key (used by POST /api/auth/login).
# Firebase console > Project settings > General > Web API Key
FIREBASE_WEB_API_KEY=

# Payment mode:
#   true  = simulated: this backend serves a fake Konnect payment page with a
#           "Payer" button. No Konnect account, no Internet needed.
#   false = real Konnect sandbox (test mode): needs the two keys below.
# (The older PAYMENT_MODE=mock|sandbox still works when KONNECT_MOCK is empty.)
KONNECT_MOCK=true

# Address of this backend as seen by the student's browser (mock payment page).
# Default: http://localhost:<PORT>. From a phone, use the PC's IP, for example
# http://192.168.1.10:5000
PUBLIC_BASE_URL=

# Konnect sandbox credentials (required only when KONNECT_MOCK=false)
# https://dashboard.sandbox.konnect.network
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# Optional: public URL Konnect calls after a payment (GET ?payment_ref=...).
# Must be reachable from the Internet (localhost does not work).
# Example: https://<public-host>/api/payments/webhook
KONNECT_WEBHOOK_URL=

# E-mail receipt sent to the student after a confirmed payment (SMTP, Nodemailer).
# Without these values the server still starts and payments still work: the
# receipt is recorded as "failed" and can be sent again later.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 and an "app password"
# as SMTP_PASS (Google account > Security > 2-step verification > App passwords).
# Port 465 = implicit TLS; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to the student, for example: CampusSave <no-reply@your-domain.com>
EMAIL_FROM=
